		(uuid "3ddfbaac-2ec9-406a-87f5-1b2ccf641b5e")
	)
	(label "MOTOR_B"
		(at 134.62 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "530b8874-a9aa-4d54-a90f-b56c2a1a9145")
	)
	(label "MOTOR_A"
		(at 177.8 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "655c11ab-ddef-446b-9a32-a8f407d3a2cc")
	)
	(label "MOTOR_B"
		(at 180.34 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce3a5eda-c009-418f-b563-cba560a3a3bb")
	)
	(text "1. 12 V input  (TVS, VM sense -> ADC1)"
		(at 10.16 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "16ad1b38-9cdf-4b01-8560-f9e0a5b342d3")
	)
	(text "VM_SENSE = VM x 8.25/54.65  (12 V -> 1.81 V)"
		(at 38.1 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "626e622d-2a54-47fb-9041-08303025c738")
	)
	(text "2. 5 V logic  (LM7805, L298 Vss)"
		(at 106.68 27.94 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "710d5c3a-9b8e-4fdf-8d29-81f8acd906ec")
	)
	(text "3. 3.3 V buck  (LM2575-ADJ, 52 kHz;  Vout = 1.23 V x (1 + 1.69k/1.00k) = 3.31 V)"
		(at 154.94 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2dd40d18-8e3f-4f73-86a8-4a1057faa931")
	)
	(text "Fixed LM2575T-3.3 instead: fit R17 as a wire link, leave R18 out."
		(at 154.94 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "35f1bc44-1013-45c0-b5b2-a2f2e6ac8711")
	)
	(text "Power flags"
		(at 317.5 13.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f205f2fc-a72c-4a35-a8ab-48aef6b8afec")
	)
	(text "4. ESP32-WROOM-32  (flash over UART J5: hold BOOT, tap RESET;  IO12 left open, it must read low at reset)"
		(at 88.9 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0b91316e-65b1-47d3-a970-b42024accceb")
	)
	(text "UART (flashing)"
		(at 220.98 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63d5813f-2dcb-412e-a4ae-119521a924c8")
	)
	(text "1 = TX (out), 2 = RX (in), 3 = GND"
		(at 243.84 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0da54dcd-a80a-481e-bb34-517d463f809b")
	)
	(text "1 = 3V3, 2 = SDA, 3 = SCL, 4 = GND"
		(at 259.08 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "434dd22f-f487-46fe-9537-b8ccb0e778b8")
	)
	(text "5. Motor driver  (L298 bridge A, PWM on IN1/IN2, EnA tied high;  1 R sense -> 1 V per A -> ADC1 -> stall = end stop)"
		(at 50.8 185.42 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1732e090-717f-4206-918d-197cf936de60")
	)
	(text "I_SENSE = 1.0 V per amp of motor current (R11 = 1 ohm under bridge A; also flows in slow decay).  Running ~0.3-0.8 A, stalled >1.8 A -> firmware stops within 60 ms."
		(at 12.7 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "05e626a4-87f4-44be-8c1c-12baee1fe400")
	)
	(text "The L298 has no current limit: the stall detection is the only protection, so keep the supply current-limited when bench testing."
		(at 12.7 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ad94df9f-20b5-46fc-8d0f-4303093c729f")
	)
	(text "Motor is a 6 V rated servo gearmotor on a 12 V bus: firmware caps PWM duty at 50 %. The L298 drops ~2-3 V, so the duty may need raising."
		(at 12.7 276.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3a2c1a23-b129-4a6f-a00e-4999cc5781db")
	)
