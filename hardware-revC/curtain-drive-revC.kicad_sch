	)
	(text "1. 12 V input  (TVS, VM sense -> ADC1)"
		(at 10.16 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f30e78a9-5d28-4bc4-9334-ab1c9b3a11ea")
	)
	(text "VM_SENSE = VM x 8.25/54.65  (12 V -> 1.81 V)"
		(at 38.1 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a24b2587-0a21-4219-9fb2-cba1952c7529")
	)
	(text "2. 5 V logic  (LM7805, L298 Vss)"
		(at 106.68 27.94 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "830b55ac-5f61-4399-9fbe-526d65901fd8")
	)
	(text "3. 3.3 V  (LM317T;  Vout = 1.25 V x (1 + 392/243) = 3.27 V;  TO-220 heatsink)"
		(at 154.94 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f82b87aa-44c1-4c47-920b-70278e37c807")
	)
	(text "About 1 W at 12 V in, 2 W during Wi-Fi TX: fit the shop's TO-220 heatsink on U3."
		(at 154.94 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a75df4b0-f70d-48a1-aad5-fd65b4077063")
	)
	(text "Power flags"
		(at 317.5 13.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "49a08d67-1d80-4143-bcfb-22806819cf2d")
	)
	(text "4. ESP32-WROOM-32  (flash over UART J5: hold BOOT, tap RESET;  IO12 left open, it must read low at reset)"
		(at 88.9 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "71cd46d3-7401-47a9-b8cb-c8bda5c621f4")
	)
	(text "UART (flashing)"
		(at 220.98 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ab06e716-70c7-49ec-85ec-fdd0ed8e4251")
	)
	(text "1 = TX (out), 2 = RX (in), 3 = GND"
		(at 243.84 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9de52628-700f-4f42-81fb-c789735b7b01")
	)
	(text "1 = 3V3, 2 = SDA, 3 = SCL, 4 = GND"
		(at 259.08 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "18851965-d845-4b97-afea-bf245bd72765")
	)
	(text "5. Motor driver  (L298 bridge A, PWM on IN1/IN2, EnA tied high;  1 R sense -> 1 V per A -> ADC1 -> stall = end stop)"
		(at 50.8 185.42 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ad5a025d-5bba-4356-a921-43d76e85a4f1")
	)
	(text "I_SENSE = 1.0 V per amp of motor current (R11 = 1 ohm under bridge A; also flows in slow decay).  Running ~0.3-0.8 A, stalled >1.8 A -> firmware stops within 60 ms."
		(at 12.7 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "96786b0b-d343-4df5-ada2-378d6c79f865")
	)
	(text "The L298 has no current limit: the stall detection is the only protection, so keep the supply current-limited when bench testing."
		(at 12.7 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "05cb671f-cc33-498f-9e61-1da577ef928f")
	)
	(text "Motor is a 6 V rated servo gearmotor on a 12 V bus: firmware caps PWM duty at 50 %. The L298 drops ~2-3 V, so the duty may need raising."
		(at 12.7 276.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e5cf5fba-fea3-47bc-a308-deea1a81e300")
	)
