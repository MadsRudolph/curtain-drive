	(text "1. Power input  (12 V DC jack -> polyfuse -> TVS -> VM;  VM sense divider -> ADC)"
		(at 12.7 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b6f8b4a4-f39c-4d27-8905-2b82c49ff476")
	)
	(text "VM = +12V (motor supply)"
		(at 50.8 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "55e56c32-db37-4f15-a2fd-0c189fcdb1bd")
	)
	(text "VM_SENSE = VM x 8.2/55.2  (12 V -> 1.78 V)"
		(at 45.72 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd13fb69-1283-4cc7-afda-59562832f29b")
	)
	(text "2. USB-C  (5 V bench power + native USB-serial/JTAG of the ESP32-C3)"
		(at 96.52 60.96 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ca3eb688-6294-4a26-8244-dab9858efe3f")
	)
	(text "3. 3.3 V buck  (AP63203, 1.1 MHz, 2 A; input = 12 V OR USB 5 V via Schottky OR)"
		(at 160.02 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "481f3b1b-d654-4b0b-8723-be1dfe8e9f4c")
	)
	(text "FB tied to VOUT (fixed 3.3 V part)"
		(at 203.2 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c825e32e-330b-4b70-9c59-cb2d2c07ad16")
	)
	(text "Power flags"
		(at 317.5 13.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d37593fb-2b03-48e9-b117-dd341d581aad")
	)
	(text "4. ESP32-C3-WROOM-02  (native USB, strapping: IO2 high via SCL pull-up, IO8 high via LED, IO9 = BOOT)"
		(at 109.22 101.6 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "dd0c9829-cd52-4751-bc32-5addae7b335c")
	)
	(text "1 = 3V3, 2 = SDA, 3 = SCL, 4 = GND"
		(at 243.84 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ae65dc07-74a4-4e28-8c80-cd2c7f02e683")
	)
	(text "5. Motor driver  (DRV8876: PWM mode IN1/IN2, IPROPI = 1 mA per A -> 1 k -> 1 V/A into the ADC -> stall = end stop)"
		(at 109.22 190.5 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1282a76a-219e-406e-9d1e-bb237a5c81ea")
	)
	(text "ITRIP = VREF / (R11 x A_IPROPI) = 2.72 V / (1 k x 1 mA/A) = 2.7 A  (fixed off-time chopping, IMODE = GND, auto-retry)"
		(at 12.7 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "87223eb0-6f50-4e2d-90a0-14d78e43109e")
	)
	(text "I_SENSE = 1.0 V per amp of motor current.  Running ~0.3-0.8 A, stalled at the end stop >2 A -> firmware stops within 50 ms."
		(at 12.7 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "85c0d4ad-fdb8-4e38-82d3-d78ce33cb5c8")
	)
	(text "Motor is a 6 V rated servo gearmotor on a 12 V bus: firmware caps PWM duty at 50 % (VM_SENSE lets it scale with supply)."
		(at 12.7 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "31f511b5-a024-4c7b-97ef-5193692e5bdc")
	)
