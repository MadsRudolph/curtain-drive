	(text "1. Power input  (12 V DC jack -> polyfuse -> TVS -> VM;  VM sense divider -> ADC)"
		(at 12.7 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4449cdb7-5b25-44b4-aca0-f56f6671169a")
	)
	(text "VM = +12V (motor supply)"
		(at 50.8 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bde4747f-37dd-4f4a-b6ad-1fb80551179d")
	)
	(text "VM_SENSE = VM x 8.2/55.2  (12 V -> 1.78 V)"
		(at 45.72 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e4b313f1-cae3-46e8-9e45-bbb1752d87f2")
	)
	(text "2. USB-C  (5 V bench power + native USB-serial/JTAG of the ESP32-C3)"
		(at 96.52 60.96 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ca961e9d-c149-46ad-81c8-7812f6aa7060")
	)
	(text "3. 3.3 V buck  (AP63203, 1.1 MHz, 2 A; input = 12 V OR USB 5 V via Schottky OR)"
		(at 160.02 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9c031be7-286e-4b29-aba8-9dda73cf95e1")
	)
	(text "FB tied to VOUT (fixed 3.3 V part)"
		(at 203.2 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dd49ab71-6414-493f-9fe6-3a00036cda38")
	)
	(text "Power flags"
		(at 317.5 13.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "578688b7-1f3d-4d8b-96f9-36a7ffc9217d")
	)
	(text "4. ESP32-C3-WROOM-02  (native USB, strapping: IO2 high via R15, IO8 high via R19, IO9 = BOOT)"
		(at 109.22 105.41 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a74a5fff-288c-4265-9623-760ee3cdfb43")
	)
	(text "1 = 3V3, 2 = SDA, 3 = SCL, 4 = GND"
		(at 243.84 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9da90d20-685c-4a08-b75c-05ec96733b3e")
	)
	(text "5. Motor driver  (DRV8876: PWM mode IN1/IN2, IPROPI = 1 mA per A -> 1 k -> 1 V/A into the ADC -> stall = end stop)"
		(at 109.22 190.5 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2236b195-39f8-4727-a759-a4a697adfdf4")
	)
	(text "ITRIP = VREF / (R11 x A_IPROPI) = 2.72 V / (1 k x 1 mA/A) = 2.7 A  (fixed off-time chopping, IMODE = GND, auto-retry)"
		(at 12.7 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2600123c-6eec-433c-9d3d-812ec3256618")
	)
	(text "I_SENSE = 1.0 V per amp of motor current.  Running ~0.3-0.8 A, stalled at the end stop >2 A -> firmware stops within 50 ms."
		(at 12.7 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cc0108cb-1a13-4ed6-b577-658ec96b1d95")
	)
	(text "Motor is a 6 V rated servo gearmotor on a 12 V bus: firmware caps PWM duty at 50 % (VM_SENSE lets it scale with supply)."
		(at 12.7 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "efe06372-4e37-4b44-bd87-294da378ae9c")
	)
